name: Arch build and install test
on:
  push:
    paths: ['PKGBUILD', '.SRCINFO', 'scripts/**', '.github/workflows/**']
  pull_request:
  workflow_dispatch:
  workflow_call:
permissions:
  contents: read
jobs:
  build:
    runs-on: ubuntu-latest
    container: archlinux:base-devel
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
      - name: Build, lint, install, smoke-test and remove
        run: bash scripts/ci-build.sh
      - name: Upload reports only (vendor restricts binary redistribution)
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: validation-reports
          path: reports/
          retention-days: 14
